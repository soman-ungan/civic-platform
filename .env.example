# backend（DATABASE_URL は backend/ から見た相対パス）
DATABASE_URL=sqlite://../data/civic.db?mode=rwc
BIND_ADDR=127.0.0.1:8080
SEEDS_DIR=../data/seeds
RUST_LOG=info,backend=debug,tower_http=debug

# frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
# 全ページのフッターに表示するソースコードのリンク（AGPL 第13条）
NEXT_PUBLIC_SOURCE_URL=https://github.com/moon-ungan/civic-platform

# 外部 API（フェーズ4で使用。値は .env にのみ書く）
# ANTHROPIC_API_KEY=
