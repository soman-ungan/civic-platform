# backend（DATABASE_URL は backend/ から見た相対パス）
DATABASE_URL=sqlite://../data/civic.db?mode=rwc
BIND_ADDR=127.0.0.1:8080
SEEDS_DIR=../data/seeds
# 開発用サンプルデータ（cargo run -- seed --dev のときだけ使う）
DEV_SEEDS_DIR=../data/dev-seeds
# 原本の置き場（git の管理外）。fetch で取った原本は <ここ>/fetched/ に置き、import が済んだら消す
PRIVATE_DIR=../data/private
# 参加者 Cookie の署名鍵（必須・32 バイト以上）。生成例: openssl rand -hex 32
SESSION_SECRET=
# 本番（HTTPS）では true にして Cookie に Secure を付ける
COOKIE_SECURE=false
# パスキー（ADR 0006）。パスキーを結び付けるドメインと、登録・ログインを行う画面のオリジン。本番ではサービスのドメイン
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
# 分析（Polis の数理処理）を再計算する間隔（秒）。0 なら定期実行しない
ANALYSIS_INTERVAL_SECS=10
RUST_LOG=info,backend=debug,tower_http=debug

# frontend
# backend の URL（Next.js のサーバー側だけで使う。ブラウザは同一オリジンの /api を呼ぶ）
API_INTERNAL_URL=http://127.0.0.1:8080
# 全ページのフッターに表示するソースコードのリンク（AGPL 第13条）
NEXT_PUBLIC_SOURCE_URL=https://github.com/soman-ungan/civic-platform
# サイトの URL（共有したときの表示の基準。本番のドメイン。開発では空でよい）
NEXT_PUBLIC_SITE_URL=
# このサービスについて・利用規約・プライバシーポリシーに載せる値（frontend/src/lib/site.ts）。
# 個人の情報を含むのでコードに書かず、ここで指定する。空なら画面に【要記入】と出る（公開の前に埋める）。
# ビルドではなく、起動したサーバーがリクエストのときに読む（イメージに焼き込まない）
# 問い合わせのメールアドレス
SITE_CONTACT_EMAIL=
# 運営者の SNS など（任意。カンマ区切りの https の URL。X・Bluesky などの名前はドメインから付く）
# 例: https://x.com/machikoe,https://bsky.app/profile/machikoe.jp
SITE_SOCIAL_LINKS=
# 運営者の名前（個人名または屋号）
SITE_OPERATOR_NAME=
# 収支を公開するページの URL
SITE_FINANCE_REPORT_URL=
# 第一審の専属的合意管轄裁判所（例: 宇都宮地方裁判所）
SITE_JURISDICTION_COURT=
# サーバーのアクセスの記録を保存する期間（例: 90日）
SITE_ACCESS_LOG_RETENTION=
# サーバーの事業者と国・地域（例: 〇〇株式会社（日本））
SITE_HOSTING=
# バックアップの保存先（例: Cloudflare, Inc.（米国）の R2。保存する地域も書く）
SITE_BACKUP=
# 消した情報がバックアップに残る最長の期間（例: 8日。本番の LITESTREAM_RETENTION に1日を足した期間）
SITE_BACKUP_RETENTION=
# AI の事業者でのデータの扱い（Anthropic の API の規約を確かめて書く。例: 送った内容は学習に使われず、〇日で消える）
SITE_AI_DATA_HANDLING=

# AI（Claude API。docs/plans/2026-10-27-phase4-ai.md）。値は .env にのみ書き、コミットしない
# キーが空なら AI を使わない（投稿は自動承認、タグ付けはしない）
ANTHROPIC_API_KEY=
# モデレーション・自動タグ付けに使うモデル
MODERATION_MODEL=claude-sonnet-5-5
TAGGING_MODEL=claude-sonnet-5-5
# LLM の1日（UTC）の費用の上限（米ドル）。超えると呼ばず、投稿は確認待ち（pending）のままになる
LLM_DAILY_BUDGET_USD=1.0
# 会議録からトピック案を作るモデルと、その1日の費用の上限（米ドル。上の上限とは別枠）
EXTRACTION_MODEL=claude-opus-5-5
LLM_EXTRACTION_DAILY_BUDGET_USD=5.0

# 行政資料の収集（docs/design/collection.md）。User-Agent に入れる運営者の連絡先（URL かメールアドレス）
# 空なら collect run は動かない。公開してよい連絡先にする（収集先のサーバーの記録に残る）
COLLECTOR_CONTACT=
