# 本番の値（docker compose が読む）。これを deploy/.env に写して埋める。deploy/.env はリポジトリに入れない
# 手順は docs/operations/deploy.md

# ドメイン（例: example.jp）。HTTPS の証明書・パスキー（WEBAUTHN_RP_ID）・共有したときの URL に使う。
# パスキーはドメインに結び付くので、公開のあとは変えない（ADR 0006）
SITE_DOMAIN=
# 使うイメージのタグ（CI が付けるコミットの SHA か latest）。ロールバックは前のタグに戻す
IMAGE_TAG=latest

# 参加者の Cookie の署名鍵（必須。openssl rand -hex 32）
SESSION_SECRET=

# 公開の前はベーシック認証をかけて本人だけで確かめる（on / off）
BASIC_AUTH=on
BASIC_AUTH_USER=
# パスワードのハッシュ: docker run --rm caddy:2 caddy hash-password --plaintext '...'
# compose が $ を変数と読まないよう、ハッシュの $ はすべて $$ に書き換える
BASIC_AUTH_HASH=

# AI（無ければ AI を使わない。ADR 0003）
ANTHROPIC_API_KEY=
MODERATION_MODEL=claude-sonnet-5-5
TAGGING_MODEL=claude-sonnet-5-5
EXTRACTION_MODEL=
LLM_DAILY_BUDGET_USD=
LLM_EXTRACTION_DAILY_BUDGET_USD=
# 資料を取りに行くときに名乗る運営者の連絡先（URL かメールアドレス。User-Agent に入る）。
# 収集先のサーバーの記録に残るので、公開してよいものにする。空なら資料の取得（fetch）は動かない
COLLECTOR_CONTACT=

# このサービスについて・利用規約・プライバシーポリシーに載せる値（frontend/src/lib/site.ts）
SITE_OPERATOR_NAME=
# 収支を公開するページの URL。まだ無ければ文章でもよい（https で始まるときだけリンクにする）
SITE_FINANCE_REPORT_URL=
SITE_JURISDICTION_COURT=
# ACCESS_LOG_KEEP（下）と同じ期間を書く（例: 90日）
SITE_ACCESS_LOG_RETENTION=90日
SITE_HOSTING=
# バックアップの保存先（例: Cloudflare, Inc.（米国）の R2。保存する地域も書く）
SITE_BACKUP=
# 消した情報がバックアップに残る最長の期間。LITESTREAM_RETENTION（下）に、まるごとの写しの間隔（1日）を
# 足した期間を書く（168h なら 8日）
SITE_BACKUP_RETENTION=8日
SITE_AI_DATA_HANDLING=
SITE_CONTACT_EMAIL=
# 運営者の SNS など（任意。カンマ区切りの https の URL）。足したら docker compose up -d frontend
SITE_SOCIAL_LINKS=

# Caddy のアクセスの記録を残す期間（Go の時間の書き方。2160h = 90日）
ACCESS_LOG_KEEP=2160h

# バックアップ（Litestream → Cloudflare R2）。R2 のバケットと、そのバケットだけに
# Object Read & Write の API トークンを作って入れる（docs/operations/deploy.md の「バックアップと復元」）
LITESTREAM_BUCKET=
# https://<アカウント ID>.r2.cloudflarestorage.com
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# 戻せる期間（まるごとの写しを残す期間。168h = 7日）。消した情報もこの期間はバックアップに残る
LITESTREAM_RETENTION=168h

RUST_LOG=info
