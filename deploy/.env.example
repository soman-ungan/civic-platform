# 本番の値（docker compose が読む）。これを deploy/.env に写して埋める。deploy/.env はリポジトリに入れない
# 手順は docs/operations/deploy.md

# ドメイン（例: example.jp）。HTTPS の証明書・パスキー（WEBAUTHN_RP_ID）・共有したときの URL に使う。
# パスキーはドメインに結び付くので、公開のあとは変えない（ADR 0006）
SITE_DOMAIN=
# 使うイメージのタグ（CI が付けるコミットの SHA か latest）。ロールバックは前のタグに戻す
IMAGE_TAG=latest

# 参加者の Cookie の署名鍵（必須。openssl rand -hex 32）
SESSION_SECRET=

# 公開の前はベーシック認証をかけて本人だけで確かめる（on / off）
BASIC_AUTH=on
BASIC_AUTH_USER=
# パスワードのハッシュ: docker run --rm caddy:2 caddy hash-password --plaintext '...'
# compose が $ を変数と読まないよう、ハッシュの $ はすべて $$ に書き換える
BASIC_AUTH_HASH=

# AI（無ければ AI を使わない。ADR 0003）
ANTHROPIC_API_KEY=
MODERATION_MODEL=claude-sonnet-5-5
TAGGING_MODEL=claude-sonnet-5-5
EXTRACTION_MODEL=
LLM_DAILY_BUDGET_USD=
LLM_EXTRACTION_DAILY_BUDGET_USD=
# 資料を取りに行くときに名乗る連絡先（リポジトリの URL など）
COLLECTOR_CONTACT=https://github.com/soman-ungan/civic-platform

# このサービスについて・利用規約・プライバシーポリシーに載せる値（frontend/src/lib/site.ts）
SITE_OPERATOR_NAME=
SITE_FINANCE_REPORT_URL=
SITE_JURISDICTION_COURT=
# ACCESS_LOG_KEEP（下）と同じ期間を書く（例: 90日）
SITE_ACCESS_LOG_RETENTION=90日
SITE_HOSTING=
SITE_AI_DATA_HANDLING=
SITE_CONTACT_EMAIL=

# Caddy のアクセスの記録を残す期間（Go の時間の書き方。2160h = 90日）
ACCESS_LOG_KEEP=2160h

RUST_LOG=info
